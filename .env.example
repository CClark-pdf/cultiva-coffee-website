DATABASE_URL="postgresql://postgres:password@localhost:5432/cultiva?schema=public"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_ENCRYPTION_KEY="replace-with-64-hex-characters"
APP_URL="http://localhost:3000"
# Customer password recovery (requires a verified sender domain in Resend).
RESEND_API_KEY=""
RESET_FROM_EMAIL="CULTIVA <hello@your-verified-domain.com>"
# Optional one-time first Admin setup. Generate 32 random bytes as 64 hex characters.
ADMIN_SETUP_TOKEN=""
# Used only by npm run admin:create. Never commit real credentials.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Owner"
