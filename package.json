{
  "name": "cultiva-coffee",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/preview.mjs",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "admin:create": "node --env-file-if-exists=.env --import tsx scripts/create-admin.ts",
    "test": "node --env-file-if-exists=.env --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev:app": "next dev --hostname 0.0.0.0"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.2",
    "otpauth": "^9.4.1",
    "qrcode": "^1.5.4",
    "lucide-react": "^0.468.0",
    "zod": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0"
  },
  "devDependencies": {
    "prisma": "6.19.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/qrcode": "^1.5.5",
    "embedded-postgres": "^18.1.0-beta.16"
  },
  "type": "module"
}
