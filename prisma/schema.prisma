generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  role String @default("CUSTOMER")
  active Boolean @default(true)
  totpSecret String?
  totpEnabled Boolean @default(false)
  lastTotpStep BigInt @default(0)
  recoveryHashes String[] @default([])
  createdAt DateTime @default(now())
  sessions Session[]
  orders Order[]
  bookings Booking[]
  notifications Notification[]
  resetTokens PasswordResetToken[]
}
model PasswordResetToken {
  id String @id
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}
model Notification {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  title String
  message String
  bookingId String?
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}
model Session {
  id String @id
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  verified Boolean @default(false)
  expiresAt DateTime
  @@index([userId])
}
model Attempt {
  key String @id
  count Int @default(1)
  expiresAt DateTime
}
model Product {
  id String @id @default(cuid())
  name String
  description String
  category String
  price Int
  image String
  available Boolean @default(true)
  featured Boolean @default(false)
  uploadedImage ProductImage?
}
model ProductImage {
  productId String @id
  product Product @relation(fields:[productId], references:[id], onDelete:Cascade)
  bytes Bytes
  mimeType String
  updatedAt DateTime @updatedAt
}
model Package {
  id String @id @default(cuid())
  name String
  servings Int
  hours Int
  price Int
  transportFee Int @default(0)
  description String
  active Boolean @default(true)
}
model Order {
  id String @id @default(cuid())
  userId String?
  user User? @relation(fields:[userId], references:[id])
  customerName String
  channel String @default("PICKUP")
  status String @default("PENDING")
  items Json
  total Int
  paid Int @default(0)
  paymentMethod String?
  payments Json @default("[]")
  pickupDate String?
  pickupTime String?
  createdAt DateTime @default(now())
  @@index([pickupDate, pickupTime, status])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}
model Booking {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId], references:[id])
  packageName String
  eventDate String
  eventTime String
  eventType String
  venue String
  name String
  phone String
  guests Int
  notes String @default("")
  status String @default("PENDING")
  total Int
  packagePrice Int @default(0)
  transportFee Int @default(0)
  paid Int @default(0)
  payments Json @default("[]")
  createdAt DateTime @default(now())
  allocations Allocation[]
  @@index([eventDate, status])
  @@index([userId, eventDate])
  @@index([status, eventDate])
}
model PickupSchedule {
  weekday Int @id
  enabled Boolean @default(true)
  opensAt String @default("08:00")
  closesAt String @default("18:00")
  capacity Int @default(5)
}
model BlockedDate {
  date String @id
  reason String
}
model Asset {
  id String @id @default(cuid())
  name String
  category String
  quantity Int
  damaged Int @default(0)
  lost Int @default(0)
  allocations Allocation[]
}
model Allocation {
  id String @id @default(cuid())
  bookingId String
  booking Booking @relation(fields:[bookingId], references:[id])
  assetId String
  asset Asset @relation(fields:[assetId], references:[id])
  quantity Int
  returned Boolean @default(false)
  damaged Int @default(0)
  lost Int @default(0)
  @@unique([bookingId,assetId])
}
model Audit {
  id String @id @default(cuid())
  actor String
  action String
  target String
  createdAt DateTime @default(now())
}
